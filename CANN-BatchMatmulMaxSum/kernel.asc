// BatchMatmulMaxSum —— npu_kernel_dev 提交形态
// 被平台 host 驱动 main.asc #include；不要加 main() / #pragma once / include guard。
// 计算语义：BatchMatMul(B,M,K)x(B,K,N)->(B,M,N) -> MaxSim(N) -> Sum(M) -> (B,) fp32
// transposeX1/transposeX2 只描述 storage 布局，不改变逻辑 shape。
#include <algorithm>
#include <cstdint>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "kernel_tiling/kernel_tiling.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include "lib/matmul_intf.h"

namespace bmm_maxsum {
constexpr int TILE_M = 32;       // 每个 block 一次处理的 M 行
constexpr int TILE_N = 128;      // 每个 N 方向的归约分块
constexpr int PARTIAL_STRIDE = 8; // 每个 M-tile 的 partial 槽位（32B 对齐）

template <typename T, bool TRANS_A, bool TRANS_B>
class FusedKernel {
public:
    matmul::Matmul<
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TRANS_A>,
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TRANS_B>,
        matmul::MatmulType<AscendC::TPosition::VECIN, CubeFormat::ND_ALIGN, float>> mm;

    __aicore__ inline void Init(GM_ADDR a, GM_ADDR b, GM_ADDR partial,
        int batches, int m, int n, int k, int workers, AscendC::TPipe* pipe,
        const AscendC::tiling::TCubeTiling& tiling)
    {
        batches_ = batches; m_ = m; n_ = n; k_ = k; workers_ = workers;
        tilesM_ = (m + TILE_M - 1) / TILE_M;
        baseM_ = tiling.baseM; baseN_ = tiling.baseN;
        a_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(a));
        b_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(b));
        partial_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
        pipe->InitBuffer(cQueue_, 1, baseM_ * baseN_ * sizeof(float));
        pipe->InitBuffer(reducedBuf_, 2 * TILE_M * sizeof(float));
        pipe->InitBuffer(outQueue_, 1, PARTIAL_STRIDE * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        auto reduced = reducedBuf_.Get<float>();
        const auto eventVS = static_cast<event_t>(::GetTPipePtr()->FetchEventID(AscendC::HardEvent::V_S));
        const auto eventSMTE3 = static_cast<event_t>(::GetTPipePtr()->FetchEventID(AscendC::HardEvent::S_MTE3));
        const auto eventMTE3S = static_cast<event_t>(::GetTPipePtr()->FetchEventID(AscendC::HardEvent::MTE3_S));
        const int tasks = batches_ * tilesM_;
        for (int task = AscendC::GetBlockIdx(); task < tasks; task += workers_) {
            const int batch = task / tilesM_;
            const int m0 = (task % tilesM_) * TILE_M;
            const int rows = (m_ - m0 < TILE_M) ? m_ - m0 : TILE_M;
            float maxima[TILE_M];
            for (int r = 0; r < rows; ++r) maxima[r] = -__builtin_inff(); // 全负行返回最大负数
            const int64_t aOffset = int64_t(batch) * m_ * k_ +
                (TRANS_A ? int64_t(m0) : int64_t(m0) * k_);
            for (int n0 = 0; n0 < n_; n0 += TILE_N) {
                const int cols = (n_ - n0 < TILE_N) ? n_ - n0 : TILE_N;
                const int64_t bOffset = int64_t(batch) * k_ * n_ +
                    (TRANS_B ? int64_t(n0) * k_ : int64_t(n0));
                mm.SetOrgShape(m_, n_, k_);
                mm.SetSingleShape(rows, cols, k_);
                mm.SetTensorA(a_[aOffset], TRANS_A);
                mm.SetTensorB(b_[bOffset], TRANS_B);
                int iteration = 0;
                while (mm.template Iterate<true>()) {
                    const int r0 = iteration * baseM_;
                    const int validRows = (rows - r0 < baseM_) ? rows - r0 : baseM_;
                    auto c = cQueue_.AllocTensor<float>();
                    // 运行时 N 尾块复用 tiling 时需要显式 padding 维；padding 值不进入归约
                    mm.template GetTensorC<true, true>(c, 0, true, validRows, cols);
                    cQueue_.EnQue(c);
                    c = cQueue_.DeQue<float>();
                    const int stride = (cols + 7) / 8 * 8;
                    const int firstCols = cols < 64 ? cols : 64;
                    // 阶段二：沿 N 做 MaxSim（WholeReduceMax，而非 ReduceSum）
                    AscendC::WholeReduceMax(reduced, c, firstCols, validRows, 1, 1,
                        stride / 8, AscendC::ReduceOrder::ORDER_ONLY_VALUE);
                    if (cols > 64) {
                        AscendC::WholeReduceMax(reduced[TILE_M], c[64], cols - 64,
                            validRows, 1, 1, stride / 8,
                            AscendC::ReduceOrder::ORDER_ONLY_VALUE);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Max(reduced, reduced, reduced[TILE_M], validRows);
                    }
                    AscendC::SetFlag<AscendC::HardEvent::V_S>(eventVS);
                    AscendC::WaitFlag<AscendC::HardEvent::V_S>(eventVS);
                    for (int r = 0; r < validRows; ++r) {
                        const float value = reduced.GetValue(r);
                        if (value > maxima[r0 + r]) maxima[r0 + r] = value;
                    }
                    cQueue_.FreeTensor(c);
                    ++iteration;
                }
                mm.End();
            }
            // 阶段三：沿 M 求和（fp32 + Kahan 补偿），存入该 M-tile 的 partial 槽
            float sum = 0.0f, compensation = 0.0f;
            for (int r = 0; r < rows; ++r) {
                const float corrected = maxima[r] - compensation;
                const float next = sum + corrected;
                compensation = (next - sum) - corrected;
                sum = next;
            }
            auto out = outQueue_.AllocTensor<float>();
            for (int i = 0; i < PARTIAL_STRIDE; ++i) out.SetValue(i, 0.0f);
            out.SetValue(0, sum);
            AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(eventSMTE3);
            AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(eventSMTE3);
            outQueue_.EnQue(out);
            out = outQueue_.DeQue<float>();
            AscendC::DataCopy(partial_[task * PARTIAL_STRIDE], out, PARTIAL_STRIDE);
            AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(eventMTE3S);
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(eventMTE3S);
            outQueue_.FreeTensor(out);
        }
    }

private:
    int batches_, m_, n_, k_, workers_, tilesM_, baseM_, baseN_;
    AscendC::GlobalTensor<T> a_, b_;
    AscendC::GlobalTensor<float> partial_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> cQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> reducedBuf_;
};

template <typename T, bool TRANS_A, bool TRANS_B>
__global__ __mix__(1, 2) void fused(GM_ADDR a, GM_ADDR b, GM_ADDR partial,
    __kfc_workspace__ GM_ADDR workspace, AscendC::tiling::TCubeTiling tiling,
    int batches, int m, int n, int k, int workers)
{
    AscendC::TPipe pipe;
    FusedKernel<T, TRANS_A, TRANS_B> op;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), op.mm, &tiling);
    op.Init(a, b, partial, batches, m, n, k, workers, &pipe, tiling);
    op.Process();
}

__global__ __aicore__ void finalize(GM_ADDR partial, GM_ADDR output, int batches, int tilesM)
{
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueue;
    pipe.InitBuffer(inQueue, 1, tilesM * PARTIAL_STRIDE * sizeof(float));
    pipe.InitBuffer(outQueue, 1, 32);
    AscendC::GlobalTensor<float> source, y;
    source.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
    y.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(output));
    const auto eventMTE2S = static_cast<event_t>(pipe.FetchEventID(AscendC::HardEvent::MTE2_S));
    const auto eventSMTE3 = static_cast<event_t>(pipe.FetchEventID(AscendC::HardEvent::S_MTE3));
    const auto eventMTE3S = static_cast<event_t>(pipe.FetchEventID(AscendC::HardEvent::MTE3_S));
    for (int batch = AscendC::GetBlockIdx(); batch < batches; batch += AscendC::GetBlockNum()) {
        auto in = inQueue.AllocTensor<float>();
        AscendC::DataCopy(in, source[int64_t(batch) * tilesM * PARTIAL_STRIDE],
            tilesM * PARTIAL_STRIDE);
        inQueue.EnQue(in);
        in = inQueue.DeQue<float>();
        AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(eventMTE2S);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(eventMTE2S);
        float sum = 0.0f, compensation = 0.0f;
        for (int t = 0; t < tilesM; ++t) {
            const float corrected = in.GetValue(t * PARTIAL_STRIDE) - compensation;
            const float next = sum + corrected;
            compensation = (next - sum) - corrected;
            sum = next;
        }
        inQueue.FreeTensor(in);
        auto out = outQueue.AllocTensor<float>();
        out.SetValue(0, sum);
        AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(eventSMTE3);
        AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(eventSMTE3);
        outQueue.EnQue(out);
        out = outQueue.DeQue<float>();
        AscendC::DataCopyExtParams copy{1, sizeof(float), 0, 0, 0};
        AscendC::DataCopyPad(y[batch], out, copy);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(eventMTE3S);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(eventMTE3S);
        outQueue.FreeTensor(out);
    }
}

template <typename T>
void Launch(GM_ADDR a, GM_ADDR b, GM_ADDR partial, GM_ADDR workspace,
    const AscendC::tiling::TCubeTiling& tiling, int batches, int m, int n, int k,
    int blockNum, aclrtStream stream, bool tx1, bool tx2)
{
    const int workers = blockNum * 2;
    if (tx1 && tx2) fused<T, true, true><<<blockNum, nullptr, stream>>>(
        a, b, partial, workspace, tiling, batches, m, n, k, workers);
    else if (tx1) fused<T, true, false><<<blockNum, nullptr, stream>>>(
        a, b, partial, workspace, tiling, batches, m, n, k, workers);
    else if (tx2) fused<T, false, true><<<blockNum, nullptr, stream>>>(
        a, b, partial, workspace, tiling, batches, m, n, k, workers);
    else fused<T, false, false><<<blockNum, nullptr, stream>>>(
        a, b, partial, workspace, tiling, batches, m, n, k, workers);
}
} // namespace bmm_maxsum

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream, bool transposeX1, bool transposeX2)
{
    using namespace bmm_maxsum;
    const auto& a = info_x1.tensors[0];
    const auto& b = info_x2.tensors[0];
    // dtype 枚举（harness 契约）：0=fp32 1=fp16 2=bf16 …… 仅支持 fp16/bf16
    if (a.numDims != 3 || b.numDims != 3 || a.dtype != b.dtype ||
        (a.dtype != 1 && a.dtype != 2)) {
        return;
    }
    const int batches = a.shape[0];
    const int m = a.shape[transposeX1 ? 2 : 1];
    const int k = a.shape[transposeX1 ? 1 : 2];
    const int n = b.shape[transposeX2 ? 1 : 2];
    if (batches <= 0 || m <= 0 || n <= 0 || k <= 0 || b.shape[0] != batches ||
        b.shape[transposeX2 ? 2 : 1] != k || info_y.tensors[0].dtype != 0 ||
        info_y.tensors[0].numDims != 1 || info_y.tensors[0].shape[0] != batches) {
        return;
    }
    const int tilesM = (m + TILE_M - 1) / TILE_M;
    const int tasks = batches * tilesM;
    const int cores = std::max<int64_t>(1, availableCoreNum);
    const int blockNum = std::min(cores, (tasks + 1) / 2);
    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance(aclrtGetSocName());
    if (platform == nullptr) return;
    matmul_tiling::MatmulApiTiling api(*platform);
    const auto dtype = a.dtype == 1 ? matmul_tiling::DataType::DT_FLOAT16 :
        matmul_tiling::DataType::DT_BF16;
    api.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, dtype, transposeX1);
    api.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, dtype, transposeX2);
    api.SetCType(matmul_tiling::TPosition::VECIN, matmul_tiling::CubeFormat::ND_ALIGN,
        matmul_tiling::DataType::DT_FLOAT);
    api.SetOrgShape(m, n, k);
    api.SetShape(std::min(m, TILE_M), std::min(n, TILE_N), k);
    // 固定 base tile 不能超过对齐后的单核 shape；M=N=1 需要 16x16 base
    const int baseM = std::min(TILE_M, (m + 15) / 16 * 16);
    const int baseN = std::min(TILE_N, (n + 15) / 16 * 16);
    api.SetFixSplit(baseM, baseN, -1);
    api.SetBias(false);
    api.SetBufferSpace(-1, -1, 128 * 1024);
    AscendC::tiling::TCubeTiling tiling;
    if (api.GetTiling(tiling) == -1) return;
    tiling.stepM = 1; tiling.stepN = 1;
    void* workspace = nullptr;
    const size_t systemBytes = platform->GetLibApiWorkSpaceSize();
    const size_t partialBytes = size_t(tasks) * PARTIAL_STRIDE * sizeof(float);
    const size_t alignedSystemBytes = (systemBytes + 511) / 512 * 512;
    if (aclrtMalloc(&workspace, alignedSystemBytes + partialBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        return;
    }
    GM_ADDR workspace_gm = reinterpret_cast<GM_ADDR>(reinterpret_cast<uint64_t>(workspace));
    GM_ADDR partial = workspace_gm + alignedSystemBytes;
    if (a.dtype == 1) Launch<half>(x1, x2, partial, workspace_gm,
        tiling, batches, m, n, k, blockNum, stream, transposeX1, transposeX2);
    else Launch<bfloat16_t>(x1, x2, partial, workspace_gm,
        tiling, batches, m, n, k, blockNum, stream, transposeX1, transposeX2);
    finalize<<<std::min(batches, cores * 2), nullptr, stream>>>(partial, y, batches, tilesM);
    aclrtSynchronizeStream(stream);
    aclrtFree(workspace);
}
